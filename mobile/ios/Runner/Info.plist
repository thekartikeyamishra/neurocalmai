<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>NeuroCalm AI</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>NeuroCalm AI</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>

		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>remote-notification</string>
		</array>

		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>

		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>

		<!-- Google Sign-In is not offered in the UI (anonymous accounts only), so the
		     placeholder URL scheme was removed; a placeholder scheme is an App Review flag. -->

		<!-- Hardware Privacy Descriptions -->
		<key>NSMicrophoneUsageDescription</key>
		<string>NeuroCalm uses the microphone only when you tap to speak. Your recording is sent securely to generate your reflection, is not stored by us, and is deleted from your phone right after.</string>
		<key>NSCameraUsageDescription</key>
		<string>NeuroCalm uses the front camera only when you start a mood scan. The image is analysed on your phone and is never saved or uploaded.</string>

		<key>NSSpeechRecognitionUsageDescription</key>
		<string>NeuroCalm turns your spoken thoughts into text so you can reflect hands-free. This only happens when you tap the microphone.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Choose a photo for a mood scan. The photo is analysed on your phone and never uploaded.</string>
		<key>NSHealthShareUsageDescription</key>
		<string>With your permission, NeuroCalm reads sleep and step counts to show how rest and activity relate to your mood. This data stays on your phone.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>NeuroCalm can save mindful minutes from breathing sessions to Apple Health if you allow it.</string>
		<key>NSUserTrackingUsageDescription</key>
		<string>This lets us show you more relevant sponsor messages, which keeps NeuroCalm free. You can say no and still use every feature.</string>

		<!-- Geolocator Privacy Descriptions for Community Hubs -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Only when you look for nearby Grounding Circles, NeuroCalm uses your approximate city to show groups near you. Your precise location is never stored.</string>

		<!-- Google AdMob Identifier -->
		<key>GADApplicationIdentifier</key>
		<string>ca-app-pub-4557897331416844~2962544256</string>
		<!-- Google's SKAdNetwork id (required for AdMob attribution on iOS 14+).
		     Add the full partner list from AdMob docs if you enable mediation. -->
		<key>SKAdNetworkItems</key>
		<array>
			<dict>
				<key>SKAdNetworkIdentifier</key>
				<string>cstr6suwn9.skadnetwork</string>
			</dict>
		</array>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>

		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
	</dict>
</plist>