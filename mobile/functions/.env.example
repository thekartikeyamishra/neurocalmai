# Copy to functions/.env (git-ignored) and deploy. Every value has a safe default.
# ---- AI routing (server decides; clients can't pick expensive models) ----
AI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# ---- Economy ----
STARTER_CREDITS=20
FREE_DAILY_AI_CALLS=5
HARD_DAILY_CAP_FREE=60
HARD_DAILY_CAP_PREMIUM=250
AI_BURST_PER_MINUTE=6
REWARDED_AD_CREDITS=2
REWARDED_ADS_DAILY_CAP=15
REWARDED_AD_MIN_INTERVAL_SECONDS=20
# Set true ONLY after AdMob SSV is configured on the rewarded ad unit.
REQUIRE_ADMOB_SSV=false
CREDITS_SACHET_CBT_10=10
CREDITS_SACHET_CBT_25=25
# ---- Referrals ----
REFERRAL_RECEIVER_CREDITS=5
REFERRAL_REFERRER_CREDITS=5
REFERRAL_MONTHLY_CAP=30
REFERRAL_MAX_ACCOUNT_AGE_DAYS=14
# Secrets are NOT set here. Use:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set RC_WEBHOOK_SECRET

# Estimated blended AI cost per call in micro-USD for the admin dashboard (900 = $0.0009)
AI_COST_PER_CALL_MICROUSD=900
